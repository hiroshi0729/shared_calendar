<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-lg shadow-md p-8">
      <!-- プロフィール情報 -->
      <div class="flex items-center mb-6">
        <img 
          src="<%= @user.avatar_url %>" 
          alt="<%= @user.name || @user.email %>" 
          class="w-24 h-24 rounded-full object-cover border-4 border-blue-500 flex-shrink-0"
        >
        <div class="ml-6">
          <h1 class="text-3xl font-bold text-gray-800">
            <%= @user.name || @user.email.split('@').first %>
          </h1>
          <p class="text-gray-600 mt-1"><%= @user.email %></p>
        </div>
      </div>
      
      <!-- ユーザー情報 -->
      <div class="border-t pt-6 mt-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">ユーザー情報</h2>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-600">登録日:</span>
            <span class="text-gray-800 font-medium">
              <%= @user.created_at.strftime("%Y年%m月%d日") %>
            </span>
          </div>
        </div>
      </div>
      
      <!-- アクションボタン -->
      <div class="flex gap-4 mt-8">
        <%= link_to "チャットする", "#", 
          class: "flex-1 px-6 py-3 bg-green-500 text-white text-center rounded-lg hover:bg-green-600 transition-colors duration-200",
          data: { friend_id: @user.id } %>
        <%= link_to "友達一覧に戻る", users_path, 
          class: "flex-1 px-6 py-3 bg-gray-300 text-gray-700 text-center rounded-lg hover:bg-gray-400 transition-colors duration-200" %>
      </div>
    </div>
  </div>
</div>