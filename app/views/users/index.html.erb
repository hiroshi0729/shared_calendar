<div class="container">
  <h1>ユーザー一覧</h1>
  
  <% if @users.any? %>
    <ul class="list-group">
      <% @users.each do |user| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= user.email %>
          
          <% friendship = current_user.friendships.find_by(friend: user) %>
          <% inverse_friendship = current_user.inverse_friendships.find_by(user: user) %>
          
          <div>
            <% if friendship %>
              <% if friendship.pending? %>
                <span class="badge bg-warning">申請中</span>
              <% elsif friendship.accepted? %>
                <span class="badge bg-success me-2">友達</span>
                <%= link_to 'カレンダーを見る', calendar_user_path(user), class: 'btn btn-primary btn-sm' %>
              <% end %>
            <% elsif inverse_friendship %>
              <% if inverse_friendship.pending? %>
                <span class="badge bg-info">申請を受信中</span>
              <% elsif inverse_friendship.accepted? %>
                <span class="badge bg-success me-2">友達</span>
                <%= link_to 'カレンダーを見る', calendar_user_path(user), class: 'btn btn-primary btn-sm' %>
              <% end %>
            <% else %>
              <%= button_to '友達申請', user_friendships_path(user), method: :post, class: 'btn btn-primary btn-sm' %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>他のユーザーがいません</p>
  <% end %>
</div>