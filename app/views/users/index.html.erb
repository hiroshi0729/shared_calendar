<div class="container mx-auto px-4 py-8">
  <!-- ヘッダー -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-800">友達一覧</h1>
    <p class="text-gray-600 mt-2">承認済みの友達: <%= @friends.count %>人</p>
  </div>
  
  <!-- 友達がいる場合 -->
  <% if @friends.any? %>
    <div class="space-y-4">
      <% @friends.each do |friend| %>
        <!-- カード全体の横幅を1000pxに制限し、中央寄せ -->
        <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden border border-gray-200 max-w-[1000px] mx-auto">
          <div class="p-6">
            <!-- フレックスボックスで横並びにする -->
            <div class="flex items-start justify-between gap-6">
              
              <!-- 左側: アイコン・名前・アドレス -->
              <div class="flex items-start gap-4 flex-1">
                <!-- アイコン -->
                <div class="flex-shrink-0">
                  <img 
                    src="<%= friend.avatar_url %>" 
                    alt="<%= friend.name || friend.email %>" 
                    class="w-16 h-16 rounded-full object-cover border-2 border-blue-500"
                    onerror="this.src='https://ui-avatars.com/api/?name=User&background=random&size=200'"
                  >
                </div>
                
                <!-- 名前とメールアドレス -->
                <div class="flex-1 min-w-0">
                  <h2 class="text-xl font-semibold text-gray-800 mb-1">
                    <%= friend.name.presence || friend.email.split('@').first %>
                  </h2>
                  <p class="text-sm text-gray-600">
                    <%= friend.email %>
                  </p>
                </div>
              </div>
              
              <!-- 右側: プロフィールとチャットボタン -->
              <div class="flex items-center gap-3 flex-shrink-0">
                <%= link_to "プロフィール", user_path(friend), 
                  class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200 text-sm font-medium" %>
                
                <%= link_to "チャット", "#", 
                  class: "px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors duration-200 text-sm font-medium",
                  data: { friend_id: friend.id } %>
              </div>
              
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- 友達がいない場合 -->
    <div class="bg-white rounded-lg shadow-md p-8 text-center border border-gray-200 max-w-[1000px] mx-auto">
      <p class="text-gray-600 mb-4">まだ友達がいません</p>
      <%= link_to "友達を検索", friendships_path, 
        class: "inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200 font-medium" %>
    </div>
  <% end %>
</div>