<%= form_with model: @event, local: true do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    
    <div class="mb-4">
      <%= f.label :title, 'タイトル', class: 'label' %>
      <%= f.text_field :title, class: 'input input-bordered w-full' %>
    </div>
    
    <div class="mb-4">
      <%= f.label :description, '説明', class: 'label' %>
      <%= f.text_area :description, class: 'textarea textarea-bordered w-full', rows: 5 %>
    </div>
    
    <div class="mb-4">
      <%= f.label :start_time, '開始日時', class: 'label' %>
      <%= f.datetime_local_field :start_time, class: 'input input-bordered w-full' %>
    </div>
    
    <div class="mb-4">
      <%= f.label :end_time, '終了日時', class: 'label' %>
      <%= f.datetime_local_field :end_time, class: 'input input-bordered w-full' %>
    </div>
    
    <div class="flex gap-2">
      <%= f.submit @event.persisted? ? '更新' : '作成', class: 'btn btn-primary' %>
      <%= link_to 'キャンセル', events_path, class: 'btn btn-ghost' %>
    </div>
  <% end %>