<%= form_with(model: event, local: true) do |f| %>
  <% if event.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>
      <ul>
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :description, "説明" %>
    <%= f.text_area :description, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :location, "場所(任意)" %>
    <%= f.text_field :location, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :start_time, "開始時間" %>
    <%= f.datetime_local_field :start_time, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :end_time, "終了時間" %>
    <%= f.datetime_local_field :end_time, class: "form-control" %>
  </div>

  <div class="field">
  <%= f.label :guest_ids, "ゲストを招待(任意)" %>
  
  <% if current_user.accepted_friends.any? %>
    <!-- 友達がいる場合はチェックボックスを表示 -->
    <%= f.collection_check_boxes :guest_ids, current_user.accepted_friends, :id, :email do |b| %>
      <div class="form-check">
        <%= b.check_box class: "form-check-input" %>
        <%= b.label class: "form-check-label" %>
      </div>
    <% end %>
  <% else %>
    <!-- 友達がいない場合はメッセージとリンクを表示 -->
    <p class="text-muted">
      まだ友達がいません。
      <%= link_to '友達一覧', users_path, class: 'btn btn-secondary' %>
      よりゲストを招待できます。
    </p>
  <% end %>
</div>

  <div class="actions">
    <%= f.submit "保存", class: "btn btn-primary" %>
  </div>
<% end %>