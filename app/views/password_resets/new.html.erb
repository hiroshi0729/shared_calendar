<h1>パスワードリセット</h1>

<%= form_with url: password_resets_path, local: true do |f| %>
  <div class="field">
    <%= f.label :email, 'メールアドレス' %>
    <%= f.email_field :email, class: 'form-control' %>
  </div>
  
  <div class="actions">
    <%= f.submit 'パスワードリセット手順を送信', class: 'btn btn-primary' %>
  </div>
<% end %>