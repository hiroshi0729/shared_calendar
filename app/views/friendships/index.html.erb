<div class="container">
  <h1>友達管理</h1>
  
  <%# 受信した友達申請 %>
  <section class="mb-4">
    <h2>友達申請</h2>
    <% if @received_requests.any? %>
      <ul class="list-group">
        <% @received_requests.each do |friendship| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= friendship.user.email %>
            <div>
              <%= button_to '承認', accept_user_friendship_path(current_user, friendship), method: :patch, class: 'btn btn-success btn-sm' %>
              <%= button_to '拒否', reject_user_friendship_path(current_user, friendship), method: :patch, class: 'btn btn-danger btn-sm' %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>友達申請はありません</p>
    <% end %>
  </section>
  
  <%# 送信した友達申請 %>
  <section class="mb-4">
    <h2>送信した友達申請</h2>
    <% if @sent_requests.any? %>
      <ul class="list-group">
        <% @sent_requests.each do |friendship| %>
          <li class="list-group-item">
            <%= friendship.friend.email %> (承認待ち)
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>送信した友達申請はありません</p>
    <% end %>
  </section>
  
  <%# 友達一覧 %>
  <section>
    <h2>友達一覧</h2>
    <% if @friends.any? %>
      <ul class="list-group">
        <% @friends.each do |friend| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= friend.email %>
            <%= button_to '解除', friendship_path(Friendship.find_by(user: current_user, friend: friend) || Friendship.find_by(user: friend, friend: current_user)), method: :delete, class: 'btn btn-danger btn-sm', data: { confirm: '本当に解除しますか?' } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>友達がいません</p>
    <% end %>
  </section>
</div>