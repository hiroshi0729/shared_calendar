<% content_for(:title, t('.title')) %>
<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1><%= t('.title') %></h1>
      <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
        <%= f.label :email, 'メールアドレス' %>
        <%= f.email_field :email %>
      
        <%= f.label :name, '名前' %>
        <%= f.text_field :name %>
      
        <%= f.label :avatar, 'アバター' %>
        <%= f.file_field :avatar %>
      
        <%= f.submit '更新' %>
      <% end %>
    </div>
  </div>
</div>