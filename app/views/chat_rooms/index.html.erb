<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">チャットルーム一覧</h1>
    <%= link_to '新規作成', new_chat_room_path, class: 'btn btn-primary' %>
  </div>

  <div class="grid gap-4">
    <% if @chat_rooms.any? %>
      <% @chat_rooms.each do |chat_room| %>
        <div class="card hover:shadow-lg transition-shadow">
          <%= link_to chat_room_path(chat_room), class: 'block p-4' do %>
            <div class="flex justify-between items-start">
              <div>
                <h2 class="text-xl font-semibold mb-2"><%= chat_room.name %></h2>
                <% if chat_room.messages.any? %>
                  <p class="text-gray-600 text-sm">
                    最終メッセージ: <%= chat_room.messages.last.content.truncate(50) %>
                  </p>
                <% else %>
                  <p class="text-gray-400 text-sm">メッセージはまだありません</p>
                <% end %>
              </div>
              <div class="text-right">
                <span class="text-sm text-gray-500">
                  <%= chat_room.created_at.strftime('%Y/%m/%d %H:%M') %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="card p-8 text-center">
        <p class="text-gray-500">チャットルームがまだありません</p>
        <p class="text-sm text-gray-400 mt-2">「新規作成」ボタンから作成してください</p>
      </div>
    <% end %>
  </div>
</div>
