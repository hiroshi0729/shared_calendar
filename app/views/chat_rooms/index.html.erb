<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">チャット一覧</h1>
    <div class="flex gap-2">
      <%= link_to '個人チャットを作成', direct_new_chat_rooms_path, class: 'btn btn-primary' %>
      <%= link_to 'グループチャットを作成', new_chat_room_path, class: 'btn btn-secondary' %>
    </div>
  </div>

  <% if @chat_rooms.any? %>
    <div class="space-y-4">
      <% @chat_rooms.each do |chat_room| %>
        <%= link_to chat_room_path(chat_room), class: 'block' do %>
          <div class="bg-white rounded-lg shadow p-4 hover:bg-gray-50 transition">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <h2 class="text-xl font-semibold mb-2 flex items-center gap-2">
                  <span><%= chat_room.display_name(current_user) %></span>
                  
                  <%# 🆕 未読数バッジを追加 %>
                  <% unread_count = chat_room.unread_count_for(current_user) %>
                  <% if unread_count > 0 %>
                  <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-black bg-red-600 rounded-full">
                  <%= unread_count %>
                </span>
                  <% end %>
                  
                  <% if chat_room.direct_message? %>
                    <span class="text-sm text-gray-500">(個人チャット)</span>
                  <% else %>
                    <span class="text-sm text-gray-500">(グループチャット)</span>
                  <% end %>
                </h2>
                <% if chat_room.latest_message %>
                  <p class="text-gray-600 text-sm truncate">
                    <%= chat_room.latest_message.user.decorate.full_name %>:
                    <%= chat_room.latest_message.content %>
                  </p>
                  <p class="text-gray-400 text-xs mt-1">
                    <%= l chat_room.latest_message.created_at, format: :short %>
                  </p>
                <% else %>
                  <p class="text-gray-400 text-sm">メッセージはまだありません</p>
                <% end %>
              </div>
              <div class="text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-100 rounded-lg p-8 text-center">
      <p class="text-gray-600 mb-4">チャットルームがまだありません</p>
      <div class="flex gap-2 justify-center">
        <%= link_to '個人チャットを作成', direct_new_chat_rooms_path, class: 'btn btn-primary' %>
        <%= link_to 'グループチャットを作成', new_chat_room_path, class: 'btn btn-secondary' %>
      </div>
    </div>
  <% end %>
</div>