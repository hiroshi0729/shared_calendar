<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="bg-white rounded-lg shadow p-6">
    <h1 class="text-3xl font-bold mb-6">個人チャットを作成</h1>

    <%= form_with model: @chat_room, url: chat_rooms_path, local: true do |f| %>
      <%= render 'shared/error_messages', object: f.object %>

      <!-- room_type を hidden で送信 -->
      <%= f.hidden_field :room_type, value: 'direct_message' %>
      
      <!-- name も hidden で送信（空でOK、後でモデル側で自動設定） -->
      <%= f.hidden_field :name, value: 'Direct Message' %>

      <!-- チャット相手を選択 -->
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          チャット相手を選択
        </label>
        
        <% if @users.any? %>
          <div class="border border-gray-300 rounded-lg p-4 max-h-64 overflow-y-auto">
            <% @users.each do |user| %>
              <div class="flex items-center mb-3">
                <input 
                  type="radio" 
                  name="user_ids[]" 
                  value="<%= user.id %>" 
                  id="user_<%= user.id %>"
                  class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500"
                  required>
                <label for="user_<%= user.id %>" class="ml-3 text-sm text-gray-700 cursor-pointer flex-1">
                  <%= user.decorate.full_name %>
                </label>
              </div>
            <% end %>
          </div>
          <p class="text-xs text-gray-500 mt-2">※ 1人を選択してください</p>
        <% else %>
          <p class="text-gray-500 text-sm">他のユーザーが存在しません</p>
        <% end %>
      </div>

      <!-- ボタン -->
      <div class="flex gap-4">
        <%= f.submit '作成する', class: 'btn btn-primary flex-1' %>
        <%= link_to 'キャンセル', chat_rooms_path, class: 'btn btn-secondary flex-1' %>
      </div>
    <% end %>
  </div>
</div>